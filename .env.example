# Supabase (Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only session signing key (at least 32 random characters)
AUTH_JWT_SECRET=

# Required in production for distributed brute-force protection
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Gemini API key
GEMINI_API_KEY=

# Store subdomain base domain used for [tenant].storeflow.io routing
# (e.g. storeflow.io in production, localhost for `acme.localhost` dev)
APP_DOMAIN=

# Stripe billing (subscription checkout + webhook sync)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Fallback billing provider (legacy)
LS_API_KEY=
LS_STORE_ID=
LS_PRO_VARIANT_ID=
NEXT_PUBLIC_LS_BILLING_URL=

# Cron Security (Optional)
CRON_SECRET=
STORE_FLOW_ADMIN_KEY=

